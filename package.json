{
  "name": "nextjs-blog-starter",
  "version": "0.2.0",
  "description": "A Next.js template for a blog website.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/update-oss.js && node scripts/build-search.js && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/generate-feed.js && node scripts/update-oss.js && node scripts/build-search.js"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.15.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.5.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "postcss-preset-env": "^9.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
